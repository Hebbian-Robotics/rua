[
  {
    "description": "Steps run in order; movement and gripper commands in the same step start together. A refusal or incomplete/limited target stops the sequence.",
    "name": "action_sequence",
    "operation": "start_action_sequence",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "additionalProperties": false,
            "description": "A movement and gripper target in the same step start together.",
            "properties": {
              "gripper_opening": {
                "type": "number"
              },
              "max_joint_speed_degrees_per_second": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Peak speed in degrees per second; clamped to the profile maximum."
              },
              "movement": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "joints_degrees": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      },
                      "max_joint_speed_degrees_per_second": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Peak speed in degrees per second; clamped to the profile maximum."
                      }
                    },
                    "required": [
                      "joints_degrees"
                    ],
                    "title": "ActionSequenceJointsMovement",
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "max_joint_speed_degrees_per_second": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Peak speed in degrees per second; clamped to the profile maximum."
                      },
                      "orientation": {
                        "description": "A tool orientation as a client gives it.",
                        "oneOf": [
                          {
                            "description": "The approach direction and the jaw yaw about it, in degrees.",
                            "properties": {
                              "approach": {
                                "anyOf": [
                                  {
                                    "description": "A named approach direction.",
                                    "oneOf": [
                                      {
                                        "const": "down",
                                        "description": "World -Z.",
                                        "type": "string"
                                      },
                                      {
                                        "const": "forward",
                                        "description": "World +X.",
                                        "type": "string"
                                      }
                                    ]
                                  },
                                  {
                                    "items": {
                                      "type": "number"
                                    },
                                    "maxItems": 3,
                                    "minItems": 3,
                                    "title": "ApproachDirection",
                                    "type": "array"
                                  }
                                ],
                                "description": "The direction the jaws point along: a named one, or a nonzero world direction."
                              },
                              "jaw_yaw_degrees": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "approach",
                              "jaw_yaw_degrees"
                            ],
                            "title": "GraspOrientation",
                            "type": "object"
                          },
                          {
                            "description": "A raw quaternion, `[x, y, z, w]`.",
                            "properties": {
                              "quaternion": {
                                "items": {
                                  "type": "number"
                                },
                                "maxItems": 4,
                                "minItems": 4,
                                "type": "array"
                              }
                            },
                            "required": [
                              "quaternion"
                            ],
                            "title": "QuaternionOrientation",
                            "type": "object"
                          }
                        ]
                      },
                      "position_mm": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 3,
                        "minItems": 3,
                        "type": "array"
                      }
                    },
                    "required": [
                      "position_mm",
                      "orientation"
                    ],
                    "title": "ActionSequencePoseMovement",
                    "type": "object"
                  }
                ]
              }
            },
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    }
  },
  {
    "description": "Resolve pose feasibility without moving: returns projected poses, errors, available jaw yaws or refusal in input order. Execution also checks feasibility; preview is useful when the projection or orientation choice changes your next action. Omitting orientation lets the solver choose one.",
    "name": "preview_pose",
    "operation": "preview",
    "parameters": {
      "$defs": {
        "Approach": {
          "anyOf": [
            {
              "$ref": "#/$defs/NamedApproach"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "ApproachDirection",
              "type": "array"
            }
          ],
          "description": "The direction the jaws point along: a named one, or a nonzero world direction."
        },
        "ModelPreviewCandidate": {
          "additionalProperties": false,
          "properties": {
            "pose": {
              "$ref": "#/$defs/PreviewPose"
            }
          },
          "required": [
            "pose"
          ],
          "type": "object"
        },
        "NamedApproach": {
          "description": "A named approach direction.",
          "oneOf": [
            {
              "const": "down",
              "description": "World -Z.",
              "type": "string"
            },
            {
              "const": "forward",
              "description": "World +X.",
              "type": "string"
            }
          ]
        },
        "PoseOrientation": {
          "description": "A tool orientation as a client gives it.",
          "oneOf": [
            {
              "description": "The approach direction and the jaw yaw about it, in degrees.",
              "properties": {
                "approach": {
                  "$ref": "#/$defs/Approach"
                },
                "jaw_yaw_degrees": {
                  "type": "number"
                }
              },
              "required": [
                "approach",
                "jaw_yaw_degrees"
              ],
              "title": "GraspOrientation",
              "type": "object"
            },
            {
              "description": "A raw quaternion, `[x, y, z, w]`.",
              "properties": {
                "quaternion": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "quaternion"
              ],
              "title": "QuaternionOrientation",
              "type": "object"
            }
          ]
        },
        "PreviewPose": {
          "additionalProperties": false,
          "description": "Where the arm's controller would take the tool toward a pose, without moving.",
          "properties": {
            "orientation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PoseOrientation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "None leaves the orientation to the solver."
            },
            "position_mm": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "position_mm"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "poses": {
          "items": {
            "$ref": "#/$defs/ModelPreviewCandidate"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "poses"
      ],
      "type": "object"
    }
  },
  {
    "description": "Move named arms together. Pose targets use a world position and orientation; joint targets use degrees. Model guards do not detect collisions between arms or with workspace objects.",
    "name": "move_arms",
    "operation": "move_arms",
    "parameters": {
      "$defs": {
        "Approach": {
          "anyOf": [
            {
              "$ref": "#/$defs/NamedApproach"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "ApproachDirection",
              "type": "array"
            }
          ],
          "description": "The direction the jaws point along: a named one, or a nonzero world direction."
        },
        "NamedApproach": {
          "description": "A named approach direction.",
          "oneOf": [
            {
              "const": "down",
              "description": "World -Z.",
              "type": "string"
            },
            {
              "const": "forward",
              "description": "World +X.",
              "type": "string"
            }
          ]
        },
        "PoseOrientation": {
          "description": "A tool orientation as a client gives it.",
          "oneOf": [
            {
              "description": "The approach direction and the jaw yaw about it, in degrees.",
              "properties": {
                "approach": {
                  "$ref": "#/$defs/Approach"
                },
                "jaw_yaw_degrees": {
                  "type": "number"
                }
              },
              "required": [
                "approach",
                "jaw_yaw_degrees"
              ],
              "title": "GraspOrientation",
              "type": "object"
            },
            {
              "description": "A raw quaternion, `[x, y, z, w]`.",
              "properties": {
                "quaternion": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "quaternion"
              ],
              "title": "QuaternionOrientation",
              "type": "object"
            }
          ]
        },
        "Waypoint": {
          "description": "One corner of a move: joints, or a tool pose solved for joints.",
          "oneOf": [
            {
              "properties": {
                "joints_degrees": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              },
              "required": [
                "joints_degrees"
              ],
              "title": "JointsWaypoint",
              "type": "object"
            },
            {
              "properties": {
                "orientation": {
                  "$ref": "#/$defs/PoseOrientation"
                },
                "position_mm": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                }
              },
              "required": [
                "position_mm",
                "orientation"
              ],
              "title": "PoseWaypoint",
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Move several arms together: every target is planned before any arm moves,\none refusal refuses all, and when one arm ends without completing the others\nstop and hold. No collision checking between the arms.",
      "properties": {
        "max_joint_speed_degrees_per_second": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak speed in degrees per second; clamped to the profile maximum."
        },
        "targets": {
          "additionalProperties": {
            "$ref": "#/$defs/Waypoint"
          },
          "type": "object"
        }
      },
      "required": [
        "targets"
      ],
      "type": "object"
    }
  },
  {
    "description": "Set a named arm's gripper opening from 0 (closed) to 1 (fully open); intermediate values request partial openings.",
    "name": "set_arm_gripper",
    "operation": "set_gripper",
    "parameters": {
      "additionalProperties": false,
      "description": "Open or close the gripper, 0 closed to 1 open, whether the arm is holding\nor moving. It completes on arrival or on contact.",
      "properties": {
        "arm": {
          "type": "string"
        },
        "max_joint_speed_degrees_per_second": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak speed in degrees per second; clamped to the profile maximum."
        },
        "opening": {
          "type": "number"
        }
      },
      "required": [
        "opening",
        "arm"
      ],
      "type": "object"
    }
  },
  {
    "description": "Return this arm to the joint pose recorded when it was enabled, then close the gripper. Closing stops on contact, so a held object stays held; ensure the path and workspace are clear.",
    "name": "rehome",
    "operation": "rehome",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "description": "Stop this arm's motion; it holds where it stops.",
    "name": "stop",
    "operation": "stop",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "description": "Observe without moving. source=current (default) gets fresh state and camera images; source=last_sequence retrieves sampled images from the latest action sequence to investigate what happened during motion. History is only returned when requested and may be unavailable or incomplete. Optionally wait up to 10 seconds before observing.",
    "name": "observe",
    "operation": "observe",
    "parameters": {
      "$defs": {
        "ObservationSource": {
          "description": "Select fresh observations or retained evidence from the latest action sequence.",
          "enum": [
            "current",
            "last_sequence"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/ObservationSource",
          "default": "current"
        },
        "wait_seconds": {
          "default": 0.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    }
  }
]
