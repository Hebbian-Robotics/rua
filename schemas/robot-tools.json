[
  {
    "description": "Run steps in order, waiting for each to finish. During a move, pass through optional waypoints and settle at the goal. A waypoint gripper_opening starts at that crossing. A refusal, incomplete move, or limited goal ends the sequence.",
    "name": "action_sequence",
    "operation": "start_action_sequence",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "additionalProperties": false,
            "anyOf": [
              {
                "properties": {
                  "goal": {
                    "type": "object"
                  }
                },
                "required": [
                  "goal"
                ]
              },
              {
                "properties": {
                  "gripper_opening": {
                    "type": "number"
                  }
                },
                "required": [
                  "gripper_opening"
                ]
              }
            ],
            "description": "An arm action must name a goal or gripper opening. When both are present they start together.",
            "properties": {
              "goal": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "joints_degrees": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      },
                      "max_joint_speed_degrees_per_second": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Peak speed in degrees per second; clamped to the profile maximum."
                      }
                    },
                    "required": [
                      "joints_degrees"
                    ],
                    "title": "ActionSequenceJointsMovement",
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "max_joint_speed_degrees_per_second": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Peak speed in degrees per second; clamped to the profile maximum."
                      },
                      "orientation": {
                        "description": "A tool orientation as a client gives it.",
                        "oneOf": [
                          {
                            "description": "The approach direction and the jaw yaw about it, in degrees.",
                            "properties": {
                              "approach": {
                                "anyOf": [
                                  {
                                    "description": "A named approach direction.",
                                    "oneOf": [
                                      {
                                        "const": "down",
                                        "description": "World -Z.",
                                        "type": "string"
                                      },
                                      {
                                        "const": "forward",
                                        "description": "World +X.",
                                        "type": "string"
                                      }
                                    ]
                                  },
                                  {
                                    "items": {
                                      "type": "number"
                                    },
                                    "maxItems": 3,
                                    "minItems": 3,
                                    "title": "ApproachDirection",
                                    "type": "array"
                                  }
                                ],
                                "description": "The direction the jaws point along: a named one, or a nonzero world direction."
                              },
                              "jaw_yaw_degrees": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "approach",
                              "jaw_yaw_degrees"
                            ],
                            "title": "GraspOrientation",
                            "type": "object"
                          },
                          {
                            "description": "A raw quaternion, `[x, y, z, w]`.",
                            "properties": {
                              "quaternion": {
                                "items": {
                                  "type": "number"
                                },
                                "maxItems": 4,
                                "minItems": 4,
                                "type": "array"
                              }
                            },
                            "required": [
                              "quaternion"
                            ],
                            "title": "QuaternionOrientation",
                            "type": "object"
                          }
                        ]
                      },
                      "position_mm": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 3,
                        "minItems": 3,
                        "type": "array"
                      }
                    },
                    "required": [
                      "position_mm",
                      "orientation"
                    ],
                    "title": "ActionSequencePoseMovement",
                    "type": "object"
                  }
                ]
              },
              "gripper_opening": {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              "max_joint_acceleration_degrees_per_second_squared": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Joint acceleration cap in degrees per second squared; defaults to the arm profile.",
                "exclusiveMinimum": 0.0
              },
              "max_joint_jerk_degrees_per_second_cubed": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Joint jerk cap in degrees per second cubed; defaults to the arm profile.",
                "exclusiveMinimum": 0.0
              },
              "max_joint_speed_degrees_per_second": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Peak speed in degrees per second; clamped to the profile maximum."
              },
              "waypoints": {
                "default": [],
                "description": "Pass through these intermediate configurations before settling at the goal.",
                "items": {
                  "additionalProperties": false,
                  "description": "An intermediate configuration along one continuous move.",
                  "properties": {
                    "at": {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "joints_degrees": {
                              "items": {
                                "type": "number"
                              },
                              "type": "array"
                            }
                          },
                          "required": [
                            "joints_degrees"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "orientation": {
                              "description": "A tool orientation as a client gives it.",
                              "oneOf": [
                                {
                                  "description": "The approach direction and the jaw yaw about it, in degrees.",
                                  "properties": {
                                    "approach": {
                                      "anyOf": [
                                        {
                                          "description": "A named approach direction.",
                                          "oneOf": [
                                            {
                                              "const": "down",
                                              "description": "World -Z.",
                                              "type": "string"
                                            },
                                            {
                                              "const": "forward",
                                              "description": "World +X.",
                                              "type": "string"
                                            }
                                          ]
                                        },
                                        {
                                          "items": {
                                            "type": "number"
                                          },
                                          "maxItems": 3,
                                          "minItems": 3,
                                          "title": "ApproachDirection",
                                          "type": "array"
                                        }
                                      ],
                                      "description": "The direction the jaws point along: a named one, or a nonzero world direction."
                                    },
                                    "jaw_yaw_degrees": {
                                      "type": "number"
                                    }
                                  },
                                  "required": [
                                    "approach",
                                    "jaw_yaw_degrees"
                                  ],
                                  "title": "GraspOrientation",
                                  "type": "object"
                                },
                                {
                                  "description": "A raw quaternion, `[x, y, z, w]`.",
                                  "properties": {
                                    "quaternion": {
                                      "items": {
                                        "type": "number"
                                      },
                                      "maxItems": 4,
                                      "minItems": 4,
                                      "type": "array"
                                    }
                                  },
                                  "required": [
                                    "quaternion"
                                  ],
                                  "title": "QuaternionOrientation",
                                  "type": "object"
                                }
                              ]
                            },
                            "position_mm": {
                              "items": {
                                "type": "number"
                              },
                              "maxItems": 3,
                              "minItems": 3,
                              "type": "array"
                            }
                          },
                          "required": [
                            "position_mm",
                            "orientation"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "gripper_opening": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Start moving the gripper when passing this waypoint.",
                      "maximum": 1.0,
                      "minimum": 0.0,
                      "title": "GripperOpening"
                    }
                  },
                  "required": [
                    "at"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    }
  },
  {
    "description": "Resolve pose feasibility without moving: returns projected poses, errors, available jaw yaws or refusal in input order. Execution also checks feasibility; preview is useful when the projection or orientation choice changes your next action. Omitting orientation lets the solver choose one.",
    "name": "preview_pose",
    "operation": "preview",
    "parameters": {
      "$defs": {
        "Approach": {
          "anyOf": [
            {
              "$ref": "#/$defs/NamedApproach"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "ApproachDirection",
              "type": "array"
            }
          ],
          "description": "The direction the jaws point along: a named one, or a nonzero world direction."
        },
        "ModelPreviewCandidate": {
          "additionalProperties": false,
          "properties": {
            "pose": {
              "$ref": "#/$defs/PreviewPose"
            }
          },
          "required": [
            "pose"
          ],
          "type": "object"
        },
        "NamedApproach": {
          "description": "A named approach direction.",
          "oneOf": [
            {
              "const": "down",
              "description": "World -Z.",
              "type": "string"
            },
            {
              "const": "forward",
              "description": "World +X.",
              "type": "string"
            }
          ]
        },
        "PoseOrientation": {
          "description": "A tool orientation as a client gives it.",
          "oneOf": [
            {
              "description": "The approach direction and the jaw yaw about it, in degrees.",
              "properties": {
                "approach": {
                  "$ref": "#/$defs/Approach"
                },
                "jaw_yaw_degrees": {
                  "type": "number"
                }
              },
              "required": [
                "approach",
                "jaw_yaw_degrees"
              ],
              "title": "GraspOrientation",
              "type": "object"
            },
            {
              "description": "A raw quaternion, `[x, y, z, w]`.",
              "properties": {
                "quaternion": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "quaternion"
              ],
              "title": "QuaternionOrientation",
              "type": "object"
            }
          ]
        },
        "PreviewPose": {
          "additionalProperties": false,
          "description": "Where the arm's controller would take the tool toward a pose, without moving.",
          "properties": {
            "max_joint_acceleration_degrees_per_second_squared": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Joint acceleration cap in degrees per second squared; defaults to the arm profile.",
              "exclusiveMinimum": 0.0
            },
            "max_joint_jerk_degrees_per_second_cubed": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Joint jerk cap in degrees per second cubed; defaults to the arm profile.",
              "exclusiveMinimum": 0.0
            },
            "max_joint_speed_degrees_per_second": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Peak speed in degrees per second; clamped to the profile maximum.",
              "exclusiveMinimum": 0.0,
              "title": "JointSpeed"
            },
            "orientation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PoseOrientation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "None leaves the orientation to the solver."
            },
            "position_mm": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "position_mm"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "poses": {
          "items": {
            "$ref": "#/$defs/ModelPreviewCandidate"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "poses"
      ],
      "type": "object"
    }
  },
  {
    "description": "Move named arms together. Pose goals use a world position and orientation; joint goals use degrees. Grouped moves check modeled inter-arm clearance. Workspace objects require separate constraints.",
    "name": "move_arms",
    "operation": "move_arms",
    "parameters": {
      "$defs": {
        "Approach": {
          "anyOf": [
            {
              "$ref": "#/$defs/NamedApproach"
            },
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "ApproachDirection",
              "type": "array"
            }
          ],
          "description": "The direction the jaws point along: a named one, or a nonzero world direction."
        },
        "NamedApproach": {
          "description": "A named approach direction.",
          "oneOf": [
            {
              "const": "down",
              "description": "World -Z.",
              "type": "string"
            },
            {
              "const": "forward",
              "description": "World +X.",
              "type": "string"
            }
          ]
        },
        "PoseOrientation": {
          "description": "A tool orientation as a client gives it.",
          "oneOf": [
            {
              "description": "The approach direction and the jaw yaw about it, in degrees.",
              "properties": {
                "approach": {
                  "$ref": "#/$defs/Approach"
                },
                "jaw_yaw_degrees": {
                  "type": "number"
                }
              },
              "required": [
                "approach",
                "jaw_yaw_degrees"
              ],
              "title": "GraspOrientation",
              "type": "object"
            },
            {
              "description": "A raw quaternion, `[x, y, z, w]`.",
              "properties": {
                "quaternion": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                }
              },
              "required": [
                "quaternion"
              ],
              "title": "QuaternionOrientation",
              "type": "object"
            }
          ]
        },
        "Waypoint": {
          "description": "One corner of a move: joints, or a tool pose solved for joints.",
          "oneOf": [
            {
              "properties": {
                "joints_degrees": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                }
              },
              "required": [
                "joints_degrees"
              ],
              "title": "JointsWaypoint",
              "type": "object"
            },
            {
              "properties": {
                "orientation": {
                  "$ref": "#/$defs/PoseOrientation"
                },
                "position_mm": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                }
              },
              "required": [
                "position_mm",
                "orientation"
              ],
              "title": "PoseWaypoint",
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Move several arms together: every target is planned before any arm moves,\none refusal refuses all, and when one arm ends without completing the others\nstop and hold. Grouped moves check modeled clearance among participating arms.",
      "properties": {
        "goals": {
          "additionalProperties": {
            "$ref": "#/$defs/Waypoint"
          },
          "minProperties": 1,
          "type": "object"
        },
        "max_joint_speed_degrees_per_second": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak speed in degrees per second; clamped to the profile maximum.",
          "exclusiveMinimum": 0.0,
          "title": "JointSpeed"
        }
      },
      "required": [
        "goals"
      ],
      "type": "object"
    }
  },
  {
    "description": "Set a named arm's gripper opening from 0 (closed) to 1 (fully open); intermediate values request partial openings.",
    "name": "set_arm_gripper",
    "operation": "set_gripper",
    "parameters": {
      "additionalProperties": false,
      "description": "Open or close the gripper, 0 closed to 1 open, whether the arm is holding\nor moving. It completes on arrival or on contact.",
      "properties": {
        "arm": {
          "type": "string"
        },
        "max_joint_speed_degrees_per_second": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Peak speed in degrees per second; clamped to the profile maximum.",
          "exclusiveMinimum": 0.0,
          "title": "JointSpeed"
        },
        "opening": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "GripperOpening",
          "type": "number"
        }
      },
      "required": [
        "opening",
        "arm"
      ],
      "type": "object"
    }
  },
  {
    "description": "Return this arm to the joint pose and gripper opening recorded when it was enabled.",
    "name": "rehome",
    "operation": "rehome",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "description": "Stop this arm's motion; it holds where it stops.",
    "name": "stop",
    "operation": "stop",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "description": "Observe without moving. source=current (default) gets fresh state and camera images; source=last_sequence retrieves sampled images from the latest action sequence to investigate what happened during motion. History is only returned when requested and may be unavailable or incomplete. Optionally wait up to 10 seconds before observing.",
    "name": "observe",
    "operation": "observe",
    "parameters": {
      "$defs": {
        "ObservationSource": {
          "description": "Select fresh observations or retained evidence from the latest action sequence.",
          "enum": [
            "current",
            "last_sequence"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/ObservationSource",
          "default": "current"
        },
        "wait_seconds": {
          "default": 0.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    }
  }
]
