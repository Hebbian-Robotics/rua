{
  "name": "hebbian-rua-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser viewer for the Hebbian control station: live 3D arm state, cameras, recordings and manual control",
  "author": "Hebbian Robotics",
  "license": "MIT",
  "engines": {
    "node": ">=22.22"
  },
  "type": "module",
  "scripts": {
    "build": "tsrs --noEmit --fast && vite build",
    "typecheck": "tsrs --noEmit --fast",
    "lint": "biome check --error-on-warnings .",
    "lint:docs": "markdownlint-cli2 '**/*.md'",
    "format": "biome check --write .",
    "knip": "knip",
    "validate": "uv run rua-dev validate",
    "check:contracts": "uv run rua-dev contracts --check",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run lint:docs",
    "test": "uv run pytest",
    "dev": "pnpm --parallel run \"/^dev:/\"",
    "dev:viewer": "vite",
    "dev:agent": "tsx watch --conditions=development examples/typescript/viewer/server/src/main.ts",
    "start:viewer": "tsx --conditions=development examples/typescript/viewer/server/src/main.ts",
    "test:viewer": "vitest run",
    "test:package": "tsx scripts/check-client-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hebbian/mcap-tools": "github:Hebbian-Robotics/mcap-tools#9a9d57c10cd8adb5d4b5afe27bc2dadb9923b0a1",
    "@hebbian/so101-model": "github:Hebbian-Robotics/so101#37db91fad4a5f16e1d88bf791ef55a00af1d81b2",
    "@hono/node-server": "2.1.11",
    "@mcap/core": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fzstd": "^0.1.1",
    "hebbian-rua": "0.1.7",
    "hono": "4.13.19",
    "livekit-client": "^2.25.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ts-pattern": "^5.9.2",
    "uplot": "^1.6.32",
    "urdf-loader": "^0.13.1",
    "xstate": "^5.33.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "jsdom": "31.0.1",
    "json-schema-to-zod": "2.8.1",
    "knip": "^6.47.0",
    "markdownlint-cli2": "0.24.2",
    "mediabunny": "^1.66.2",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
