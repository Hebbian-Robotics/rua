{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "examples/typescript/viewer/src/app/{main,recordings-main}.tsx",
        "examples/typescript/viewer/tests/*.test.ts",
        "examples/typescript/viewer/tests/simulated-viewer-cancellation.ts",
        "examples/typescript/viewer/server/tests/*.test.ts"
      ],
      "project": ["examples/typescript/viewer/**/*.{ts,tsx}"]
    },
    "typescript-client": {
      "entry": ["tests/*.test.ts", "tests/simulated-robot-tools.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "examples/typescript/agent": {
      "entry": ["tests/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignoreBinaries": ["uv"],
  "ignoreDependencies": [
    "json-schema-to-zod",
    "shadcn",
    "tailwindcss",
    "tw-animate-css"
  ]
}
