# OPTIONAL example: stable names for USB cameras on Linux. Nothing in this
# repository requires it.
#
# A udev rule is a Linux device rule. It runs when a device appears and can give
# it a stable name or permissions. USB cameras are otherwise numbered
# (/dev/video0, /dev/video2, ...) in whatever order they are detected, which can
# change after a reboot or replug. These rules create a symlink per camera, such
# as /run/cameras/cam_chest -> /dev/video2, keyed to the USB port the camera is
# plugged into, so a camera name in your configuration keeps pointing at the same
# camera.
#
# To adapt it:
#   1. Find each camera's port path:  udevadm info -a -n /dev/video0 | rg KERNELS
#   2. Replace the KERNELS values below (the PCI/USB bus addresses are examples
#      from one machine) and the cam_* names with your own.
#   3. Copy the file to /etc/udev/rules.d/99-camera.rules, then reload:
#        sudo udevadm control --reload-rules && sudo udevadm trigger

# Example camera "cam_waist"
SUBSYSTEM=="video4linux", KERNELS=="0000:03:00.0", ATTR{index}=="0", ACTION=="add", RUN+="/bin/mkdir -p /run/cameras", RUN+="/bin/ln -sf /dev/%k /run/cameras/cam_waist"
SUBSYSTEM=="video4linux", KERNELS=="0000:03:00.0", ACTION=="remove", RUN+="/bin/rm -f /run/cameras/cam_waist"

# Example camera "cam_chest"
SUBSYSTEM=="video4linux", KERNELS=="0000:04:00.0", ATTR{index}=="0", ACTION=="add", RUN+="/bin/mkdir -p /run/cameras", RUN+="/bin/ln -sf /dev/%k /run/cameras/cam_chest"
SUBSYSTEM=="video4linux", KERNELS=="0000:04:00.0", ACTION=="remove", RUN+="/bin/rm -f /run/cameras/cam_chest"
