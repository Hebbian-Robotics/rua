from typing import TypedDict

from pydantic import JsonValue

from hebbian_rua.bindings import ToolDisposition

METRES_PER_MILLIMETRE: float
RADIANS_PER_DEGREE: float

def model_response(value: object) -> object: ...
def concise_response(
    value: object, *, keep_station_context: bool = False
) -> object: ...
def concise_output(value: object, *, keep_station_context: bool = False) -> object: ...

class Telemetry:
    async def receive(self) -> object | None: ...

class NativeStation:
    def __init__(
        self, server: str, media_server: str, run_after: int | None = None
    ) -> None: ...
    def close(self) -> None: ...
    def telemetry(self) -> Telemetry: ...
    async def state(self) -> object: ...
    def observation_cursor(self) -> tuple[int, int]: ...
    async def wait_for_observation(self, cursor: tuple[int, int]) -> None: ...
    async def next_sequence(self, revision: int) -> tuple[int, object | None]: ...
    async def camera_jpeg(
        self, name: str, maximum_bytes: int | None
    ) -> tuple[bytes, int | None]: ...
    async def download_trace(self, name: str) -> bytes: ...
    async def wait_until_connected(self) -> None: ...
    async def revoke_lease(self) -> None: ...
    async def camera_names(self) -> list[str]: ...
    async def ensure_recording(self) -> str: ...
    async def start_recording(self) -> str: ...
    async def stop_recording(self) -> None: ...
    async def recording_status(self) -> object: ...
    async def list_traces(self) -> object: ...
    async def get_operation(self, identifier: str) -> object: ...
    async def get_action_sequence(self, identifier: str) -> object: ...
    async def wait_for_action_sequence(self, identifier: str) -> object: ...
    async def cancel_action_sequence(self, identifier: str) -> None: ...
    async def inspect_compilation(self, identifier: str) -> object: ...
    async def compile_action_sequence(self, request: object) -> object: ...
    async def import_compilation(self, request: object) -> object: ...
    async def capture_observation_http(self, request: object) -> object: ...
    async def preview_poses(self, request: object) -> object: ...
    async def phone_invite(self, request: object) -> object: ...
    async def record_run_event(self, request: object) -> None: ...
    async def record_run_spans(self, request: object) -> None: ...
    async def wait_for_outcome(self, command_id: str) -> object: ...
    async def acquire_lease(self, request: object, take: bool) -> NativeLease: ...
    async def run_command(
        self, arm: str, command: object, options: object
    ) -> object: ...

class HttpError(RuntimeError):
    status: int
    body: str

class CommandRefused(RuntimeError):
    reason: str
    detail: str

class CommandIncomplete(RuntimeError):
    record: object

class LeaseHeld(RuntimeError):
    holder_status: object

class MissingCamera(RuntimeError):
    listed: object
    last_error: str | None

class NativeLease:
    def status(self) -> object: ...
    async def wait_for_observation(
        self, selection: object, arm: str, timeout_milliseconds: int
    ) -> object: ...
    async def lost(self) -> None: ...
    async def release(self) -> None: ...
    async def run_command(
        self, arm: str, command: object, options: object
    ) -> object: ...
    async def move_arms(self, command: object, options: object) -> object: ...
    async def start_sequence_execution(self, request: object) -> tuple[str, str]: ...
    async def start_compiled_execution(
        self, identifier: str, revisions: dict[str, int], continuation: object
    ) -> tuple[str, str]: ...
    async def send_operation(
        self, arm: str, identifier: str, command: object, revision: int | None
    ) -> object: ...
    async def update_stream_goal(
        self,
        identifier: str,
        sequence: int,
        joints: list[float],
        gripper_opening: float | None,
        revision: int | None,
    ) -> object: ...
    async def cancel_operation(self, identifier: str) -> None: ...
    async def report_camera(self, camera: str, available: bool) -> None: ...
    async def stop_arm(self, arm: str) -> None: ...
    async def stop_recording(self) -> None: ...

class _ToolDefinition(TypedDict):
    name: str
    description: str
    parameters: dict[str, JsonValue]

class _ToolOutcome(TypedDict):
    data: object
    cameras: dict[str, bytes]
    sequence_images: object
    disposition: ToolDisposition

class NativeTools:
    def __init__(
        self,
        lease: NativeLease,
        arm: str,
        cameras: list[str],
        optional_cameras: list[str],
    ) -> None: ...
    def configured(self, configuration: object) -> NativeTools: ...
    def history(self) -> object: ...
    async def context(self) -> dict[str, object]: ...
    async def execute(
        self, call_id: str, name: str, arguments: object, options: object
    ) -> _ToolOutcome: ...

def tool_names() -> list[str]: ...
def tool_catalog(configuration: object) -> list[_ToolDefinition]: ...
