# Copy to .env in the directory where the station and examples are launched.

# LiveKit camera streaming requires all three values from your LiveKit project.
# LIVEKIT_URL is the project's WebSocket URL (wss://).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Viewer and terminal agent examples require at least one model provider key.
# Set one or more keys and leave unused providers blank. When using the RUA CLI
# with a coding agent, configure model access in that agent instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides.
# HEBBIAN_PHONE_PAGE_URL=https://your-trusted-page.example/
# HEBBIAN_STATION_URL=http://127.0.0.1:8792
# HEBBIAN_MEDIA_SERVER=http://127.0.0.1:8781
